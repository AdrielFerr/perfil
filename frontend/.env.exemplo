# Copie para .env e ajuste.

# Alvo do proxy da API no Vite. Troque a porta se o Apache nao for a 80.
VITE_API_ALVO=http://localhost

# Subpasta em que o jogo e servido. "/" para a raiz do dominio,
# "/perfil/" para o XAMPP com a pasta em htdocs/perfil.
VITE_BASE=/perfil/

# Caminho publico da API: /perfil/api/public no XAMPP em subpasta,
# ou /api quando existe um "Alias /api" apontando para api/public.
VITE_API_BASE=/perfil/api/public
